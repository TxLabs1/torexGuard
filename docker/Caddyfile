# Caddy configuration for Torex Guard.
#
# Auto-TLS is enabled by default for any explicit hostname Caddy is given.
# Set APP_DOMAIN (e.g. guard.example.com) in /etc/environment or via `compose
# --env-file` so docker-compose substitutes it before mounting.

{
    email {$CADDY_ACME_EMAIL:ops@example.com}
    servers {
        protocols h1 h2 h3
    }
}

{$APP_DOMAIN:localhost} {
    encode zstd gzip

    # WebSockets (Reverb)
    @websocket {
        path /app/* /apps/* /api/apps/*
        header Connection *Upgrade*
        header Upgrade websocket
    }
    reverse_proxy @websocket reverb:8080

    # Reverb HTTP fallback (broadcasting auth endpoints)
    @reverbApi path /api/apps/*
    reverse_proxy @reverbApi reverb:8080

    # Application HTTP
    reverse_proxy app:80 {
        header_up X-Forwarded-Proto {scheme}
        header_up X-Real-IP        {remote_host}
        flush_interval -1
    }

    header {
        # In addition to the headers Laravel sets, harden a few transport-level
        # concerns at the edge.
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Frame-Options "DENY"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "geolocation=(), microphone=(), camera=()"
        -Server
    }

    log {
        output stdout
        format console
        level INFO
    }
}
