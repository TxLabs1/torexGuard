includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    paths:
        - app/
        - config/
        - database/factories/
        - database/seeders/

    level: 4

    excludePaths:
        - vendor/*
        - bootstrap/cache/*
        - storage/*

    checkModelProperties: false

    treatPhpDocTypesAsCertain: false

    reportUnmatchedIgnoredErrors: false

    ignoreErrors:
        # Larastan can't always resolve Eloquent dynamic relations / properties.
        - '#Access to an undefined property App\\Models\\#'
        - "#Relation '[^']+' is not found in App\\\\Models\\\\#"
        # The Illuminate\\Contracts\\Encryption\\Encrypter contract macros these at runtime.
        - '#Call to an undefined method Illuminate\\Contracts\\Encryption\\Encrypter::(encrypt|decrypt)String\(\)#'
        # PHP 8.4 PDO\\Mysql constants aren't in PHPStan's stubs yet.
        -
            message: '#Access to constant ATTR_SSL_CA on an unknown class Pdo\\Mysql#'
            path: config/database.php
        # Threat severity match arms intentionally enumerate every value.
        -
            message: '#Match arm comparison between#'
            path: app/Models/Threat.php
        # nullsafe ?->diffForHumans() etc. on Carbon — kept defensive for soft-deleted parents
        - '#Using nullsafe method call on non-nullable type Carbon\\Carbon#'
        # The Laravel skeleton's UserFactory definition signature.
        -
            message: '#Return type \(array<string, mixed>\) of method Database\\Factories\\UserFactory::definition#'
            path: database/factories/UserFactory.php
