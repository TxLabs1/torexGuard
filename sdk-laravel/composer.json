{
    "name": "torexlabs/guard",
    "description": "Torex Guard Laravel SDK — Runtime security & malware detection for Laravel apps",
    "keywords": ["laravel", "security", "malware-detection", "rasp", "intrusion-detection"],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/console": "^10.0|^11.0|^12.0",
        "illuminate/http": "^10.0|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "TorexLabs\\Guard\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": ["TorexLabs\\Guard\\TorexGuardServiceProvider"],
            "aliases": {}
        }
    },
    "minimum-stability": "stable"
}
