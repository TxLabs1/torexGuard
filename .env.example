APP_NAME="Torex Guard"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://guard.torexlabs.cloud
APP_TIMEZONE=UTC

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=14

LOG_CHANNEL=stack
LOG_STACK=single,daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=torexguard
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.torexlabs.cloud
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Sanctum stateful SPA domains (comma-separated, no scheme, no path)
SANCTUM_STATEFUL_DOMAINS=guard.torexlabs.cloud

# CORS allow-list (comma-separated full origins incl. scheme)
CORS_ALLOWED_ORIGINS=https://guard.torexlabs.cloud

# Optional custom CSP override (otherwise SecureHeaders ships a default)
# CSP_POLICY="default-src 'self'; ..."

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=torex_guard

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="alerts@torexlabs.cloud"
MAIL_FROM_NAME="Torex Guard"

# Laravel Reverb WebSocket
# If XAMPP/Apache uses :8080, switch this to e.g. :8090 locally.
REVERB_APP_ID=torex-guard
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=0.0.0.0
REVERB_PORT=8080
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_SCHEME=https

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Torex Guard Core
TOREX_GUARD_VERSION=1.0.0
TOREX_GUARD_AGENT_SECRET=
TOREX_GUARD_MAX_EVENTS_PER_MINUTE=10000
TOREX_GUARD_QUARANTINE_PATH=/var/torex-guard/quarantine
TOREX_GUARD_SCAN_CONCURRENCY=5
TOREX_GUARD_THREAT_RETENTION_DAYS=90

# Horizon
HORIZON_USERNAME=torex
HORIZON_PASSWORD=

# GeoIP — get a free key at https://www.maxmind.com/en/geolite2/signup
GEOIP_LICENSE_KEY=
GEOIP_DATABASE_PATH=database/geoip/GeoLite2-City.mmdb

# Sentry — leave SENTRY_LARAVEL_DSN blank to disable reporting
SENTRY_LARAVEL_DSN=
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.0
SENTRY_PROFILES_SAMPLE_RATE=0.0
SENTRY_SEND_DEFAULT_PII=false

# Off-site backups (any S3-compatible bucket -- Backblaze B2 / Hetzner / Wasabi)
BACKUP_S3_DISK=backups
BACKUP_S3_KEY=
BACKUP_S3_SECRET=
BACKUP_S3_REGION=us-east-1
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=
BACKUP_S3_PATH_STYLE=true
BACKUP_ARCHIVE_PASSWORD=
BACKUP_NOTIFICATION_EMAIL=
BACKUP_FILENAME_PREFIX=torex-
